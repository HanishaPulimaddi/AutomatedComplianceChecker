# Copy to .env.local and fill in when deploying the frontend separately
# from the backend (e.g. frontend on Vercel, backend on Render/Railway/Fly —
# the backend's dependencies, shapely/numpy/PyMuPDF, don't fit Vercel's
# serverless model well, so it likely needs a real long-running host).
#
# Leave this UNSET for local development — vite.config.js's dev proxy
# already forwards relative paths (/envelope, /docs, etc.) to
# http://localhost:8000, so requests correctly show "localhost" while
# developing locally. This variable is what makes production builds point
# at the real deployed backend instead of the frontend's own domain.
VITE_API_BASE_URL=https://your-backend-host.example.com
