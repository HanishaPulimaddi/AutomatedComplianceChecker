# Copy to .env and fill in the keys you actually use.

# Rule extraction / structure detection (pipeline.py) — set ONE of these two free-tier keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Deployed frontend URL(s) — required once the frontend is hosted somewhere
# other than localhost, otherwise the browser blocks it from reading
# /envelope, /cdc-eligibility and /address-suggestions responses (CORS).
# Comma-separate if there's more than one (e.g. Vercel preview + production).
FRONTEND_ORIGIN=https://your-frontend.vercel.app
